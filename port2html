<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Kemi Ehindero — PMO & Project Support Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F5F0E8;
    --sand: #E8D5B7;
    --olive: #6B7C4E;
    --olive-light: #8A9E64;
    --rust: #C4622D;
    --brown: #4A3728;
    --brown-light: #7A5C48;
    --peach: #F2B49B;
    --peach-light: #F9D9CC;
    --white: #FDFAF5;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--cream);
    color: var(--brown);
    font-size: 16px;
    line-height: 1.7;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(245, 240, 232, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--sand);
    padding: 0 2rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--brown);
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--rust); }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 100px 2rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--olive);
    margin-bottom: 1.25rem;
  }

  .hero-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--brown);
    margin-bottom: 1.5rem;
  }

  .hero-name em {
    font-style: italic;
    color: var(--rust);
  }

  .hero-tagline {
    font-size: 1rem;
    color: var(--brown-light);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 440px;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .role-tag {
    background: var(--peach-light);
    color: var(--brown);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    letter-spacing: 0.03em;
  }

  .hero-cta {
    display: inline-block;
    background: var(--rust);
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.85rem 2rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .hero-cta:hover { background: var(--brown); }

  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stat-card {
    background: var(--white);
    border: 1px solid var(--sand);
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--olive);
  }

  .stat-card.rust { border-left-color: var(--rust); }
  .stat-card.peach { border-left-color: var(--peach); }

  .stat-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--brown);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--brown-light);
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  /* SECTIONS */
  section {
    padding: 5rem 2rem;
  }

  section.alt { background: var(--sand); }
  section.white { background: var(--white); }

  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--olive);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: var(--brown);
    line-height: 1.15;
    margin-bottom: 2.5rem;
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-text p {
    color: var(--brown-light);
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .about-text p:last-child { margin-bottom: 0; }

  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aside-block {
    background: var(--cream);
    border: 1px solid var(--sand);
    padding: 1.25rem;
    border-top: 3px solid var(--rust);
  }

  .aside-block h4 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--olive);
    margin-bottom: 0.5rem;
  }

  .aside-block p {
    font-size: 0.85rem;
    color: var(--brown-light);
    line-height: 1.6;
  }

  /* PROJECT NARRATIVE */
  .project-narrative {
    background: var(--brown);
    color: var(--cream);
    padding: 3rem;
    margin-bottom: 3rem;
    position: relative;
  }

  .project-narrative::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 5px;
    background: var(--peach);
  }

  .project-narrative h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--peach);
    margin-bottom: 1rem;
  }

  .project-narrative p {
    font-size: 0.92rem;
    line-height: 1.8;
    color: #D4C5B5;
  }

  .project-narrative p + p { margin-top: 1rem; }

  /* ARTEFACT CARDS */
  .artefacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .artefact-card {
    background: var(--white);
    border: 1px solid var(--sand);
    padding: 2rem;
    position: relative;
    transition: box-shadow 0.2s;
  }

  .artefact-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--olive);
  }

  .artefact-card.rust::before { background: var(--rust); }
  .artefact-card.peach::before { background: var(--peach); }
  .artefact-card.brown::before { background: var(--brown); }

  .artefact-card:hover { box-shadow: 0 4px 20px rgba(74,55,40,0.1); }

  .artefact-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .artefact-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--brown);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .artefact-card p {
    font-size: 0.85rem;
    color: var(--brown-light);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .artefact-tag {
    display: inline-block;
    background: var(--peach-light);
    color: var(--brown);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    letter-spacing: 0.04em;
    margin-top: 0.25rem;
    margin-right: 0.25rem;
  }

  /* NSHDP */
  .nshdp-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .nshdp-text h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--brown);
    margin-bottom: 1rem;
  }

  .nshdp-text p {
    font-size: 0.9rem;
    color: var(--brown-light);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .nshdp-context {
    font-size: 0.78rem;
    color: var(--olive);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .priority-areas {
    background: var(--brown);
    padding: 2rem;
    color: var(--cream);
  }

  .priority-areas h4 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--peach);
    margin-bottom: 1.25rem;
  }

  .priority-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .priority-list li {
    font-size: 0.78rem;
    color: #C4B5A8;
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .priority-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--peach);
    font-size: 0.7rem;
  }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .skill-block {
    padding: 1.75rem;
    background: var(--white);
    border: 1px solid var(--sand);
  }

  .skill-block h4 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sand);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tag {
    background: var(--cream);
    border: 1px solid var(--sand);
    color: var(--brown);
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
    font-weight: 400;
  }

  .skill-tag.muted {
    color: var(--brown-light);
    opacity: 0.7;
    font-style: italic;
  }

  /* CERTIFICATIONS */
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .cert-card {
    background: var(--white);
    border: 1px solid var(--sand);
    border-top: 3px solid var(--olive);
    padding: 1.25rem 1.5rem;
  }

  .cert-card.rust { border-top-color: var(--rust); }
  .cert-card.peach { border-top-color: var(--peach); }

  .cert-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--brown);
    margin-bottom: 0.25rem;
  }

  .cert-issuer {
    font-size: 0.78rem;
    color: var(--brown-light);
  }

  .cert-status {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--olive);
    background: var(--peach-light);
    padding: 0.2rem 0.6rem;
  }

  /* CONTACT */
  .contact-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-inner .section-label { justify-content: center; display: block; }
  .contact-inner .section-title { margin-bottom: 1rem; }

  .contact-sub {
    font-size: 0.92rem;
    color: var(--brown-light);
    margin-bottom: 2.5rem;
  }

  .contact-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-link {
    display: inline-block;
    padding: 0.85rem 2rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s;
  }

  .contact-link.primary {
    background: var(--rust);
    color: var(--white);
  }

  .contact-link.primary:hover { background: var(--brown); }

  .contact-link.secondary {
    background: transparent;
    color: var(--brown);
    border: 1.5px solid var(--brown);
  }

  .contact-link.secondary:hover {
    background: var(--brown);
    color: var(--white);
  }

  /* FOOTER */
  footer {
    background: var(--brown);
    color: #9A8070;
    text-align: center;
    padding: 2rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  /* FADE IN */
  .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in { opacity: 1; transform: none; transition: none; }
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .nshdp-block { grid-template-columns: 1fr; gap: 2rem; }
    nav { padding: 0 1rem; }
    .nav-links { gap: 1rem; }
    .nav-links a { font-size: 0.7rem; }
    section { padding: 3.5rem 1.25rem; }
    .project-narrative { padding: 2rem 1.5rem; }
  }

  @media (max-width: 480px) {
    .nav-links { display: none; }
  }
</style>
</head>
